<?xml version="1.0" encoding="utf-8"?>
<!-- The activity is locked to landscape, so vertical room is tight. Everything
     must scroll or the Save controls become unreachable on a phone in a mount. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/calStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="FOCAL LENGTH"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Park behind a vehicle straight ahead. Tape-measure both numbers — do not estimate them."
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance to target (m)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="10.0"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Target's real width (m)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1.75"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#40808080" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOUNT GEOMETRY"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Used by the obstacle detector to work out where the road surface is. Saved with the button below."
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lens height above the road (m)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Camera pitch (degrees, negative = tilted down)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Bonnet top edge (% down the screen)"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Your own bonnet gets detected as a car. Set this to where it starts and an orange line appears — adjust until the line sits just above it. Use 100 if no bonnet is visible."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calBonnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />
    </LinearLayout>
</ScrollView>
